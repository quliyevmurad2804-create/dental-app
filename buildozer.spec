[app]
title = Dental Soft Mobile
package.name = dentalsoftmobile
package.domain = org.dental
source.dir = .
source.exts = py,png,jpg,kv,atlas
version = 1.3.3
requirements = python3,kivy,urllib3,certifi
orientation = portrait
fullscreen = 0
android.permissions = INTERNET, ACCESS_NETWORK_STATE, ACCESS_WIFI_STATE
android.api = 33
android.minapi = 21
 
[buildozer]
log_level = 2
warn_on_root = 1
